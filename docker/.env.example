# Copy to docker/.env and replace every CHANGE_ME value before running docker compose.
# Generate secrets with: python -c "import secrets; print(secrets.token_hex(32))"

# ---------- MongoDB ----------
MONGO_ROOT_USERNAME=tollgate
MONGO_ROOT_PASSWORD=CHANGE_ME
DB_NAME=tollgate

# ---------- Backend ----------
JWT_SECRET=CHANGE_ME
JWT_EXPIRE_MINUTES=60
API_KEY_HMAC_SECRET=CHANGE_ME
CORS_ORIGINS=http://localhost:8080
RATE_LIMIT_IP_PER_MINUTE=300
# Bearer token required by GET /metrics. Leave empty to disable auth (local only).
METRICS_TOKEN=

# Seeded demo account (created only when the database is empty).
DEMO_EMAIL=demo@tollgate.dev
DEMO_PASSWORD=CHANGE_ME

# Upstream OpenAI-compatible LLM. Leave empty to use the built-in placeholder responder.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# ---------- Frontend ----------
# Empty = same-origin /api through the nginx reverse proxy.
REACT_APP_BACKEND_URL=
FRONTEND_PORT=8080

# ---------- Monitoring (profile: monitoring) ----------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
